# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Environments
.env
.venv
env/
venv/

# IDE / Editor Settings
.idea/
.vscode/
*.swp
*.swo

# Project files / caches
.pytest_cache/
.pytest-temp*/
.mypy_cache/
.ruff_cache/
.pyright/
dist/
build/
*.egg-info/

# Reproducible portfolio evidence is generated locally; the normalized golden
# fixture under tests/ is the committed contract.
artifacts/portfolio/async-workflow-engine-evidence/

# Frontend generated output (the frontend's own ignore protects local use; these
# root entries protect repository-wide commands and CI artifact collection).
frontend/node_modules/
frontend/.next/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Local orchestration briefs, progress notes, and task reports are not product
# source or portfolio evidence. Keep them available in the worktree without
# making finalization branches dirty.
.superpowers/
